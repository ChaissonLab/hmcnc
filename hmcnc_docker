FROM continuumio/miniconda3:latest

# Set up channels
RUN conda config --add channels defaults && \
    conda config --add channels bioconda && \
    conda config --add channels conda-forge && \
    conda config --set channel_priority strict

# Create environment and install dependencies in one step
RUN conda create -n hmcnc -y gxx boost bedtools samtools htslib tabix

# Set shell to use the new conda environment
SHELL ["conda", "run", "-n", "hmcnc", "/bin/bash", "-c"]

# Set working directory
WORKDIR /app

# Copy the source code (assumes docker build is run from repo root)
COPY src/ /app/src/
COPY include/ /app/include/

# Compile the C++ program
WORKDIR /app/src
RUN make

# Set the command to run the program
ENTRYPOINT ["conda", "run", "-n", "hmcnc", "./hmcnc"]
